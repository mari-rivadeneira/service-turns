# PostgreSQL propio de service-turns
POSTGRES_DB=turns_db
POSTGRES_USER=turns_user
POSTGRES_PASSWORD=turns_password
POSTGRES_PORT=5433

# Servicio
SERVER_PORT=8081

# Catedra: los mismos valores que service-catalog (misma cuenta tecnica del proyecto). No commitear valores reales.
CATEDRA_API_BASE_URL=
CATEDRA_JWT_TOKEN=
# Kafka: kafkaBootstrapServers, kafkaConsumerGroupId, kafkaAppointmentActionsTopic y kafkaAppointmentPhoneTopic de la integracion
CATEDRA_KAFKA_BOOTSTRAP_SERVERS=
CATEDRA_KAFKA_CONSUMER_GROUP_ID=
CATEDRA_KAFKA_APPOINTMENT_ACTIONS_TOPIC=
CATEDRA_KAFKA_APPOINTMENT_PHONE_TOPIC=

# service-catalog (los dos servicios corren en la misma maquina: catalog en 8080)
CATALOG_API_BASE_URL=http://localhost:8080
# Opcionales: tiempos de espera (milisegundos)
# CATEDRA_API_CONNECT_TIMEOUT_MS=5000
# CATEDRA_API_READ_TIMEOUT_MS=10000
# CATALOG_API_CONNECT_TIMEOUT_MS=2000
# CATALOG_API_READ_TIMEOUT_MS=5000

# Secreto del JWT: el MISMO valor que service-catalog (Base64, minimo 64 bytes)
JWT_SECRET=
# Origenes CORS permitidos, separados por comas. Vacio = ninguno
CORS_ALLOWED_ORIGINS=