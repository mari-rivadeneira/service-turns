# PostgreSQL propio de service-turns
POSTGRES_DB=turns_db
POSTGRES_USER=turns_user
POSTGRES_PASSWORD=turns_password
POSTGRES_PORT=5433

# Servicio
SERVER_PORT=8081

# Catedra: los mismos valores que service-catalog (misma cuenta tecnica del proyecto). No commitear valores reales.
CATEDRA_API_BASE_URL=
CATEDRA_JWT_TOKEN=
# Kafka: kafkaBootstrapServers, kafkaConsumerGroupId, kafkaAppointmentActionsTopic y kafkaAppointmentPhoneTopic de la integracion
CATEDRA_KAFKA_BOOTSTRAP_SERVERS=
CATEDRA_KAFKA_CONSUMER_GROUP_ID=
CATEDRA_KAFKA_APPOINTMENT_ACTIONS_TOPIC=
CATEDRA_KAFKA_APPOINTMENT_PHONE_TOPIC=